            key-positions = <35 20 22>;
            layers = <BASE MOUSE SNIPE WARP SCROLL>;
            slow-release;
            key-positions-first-exclude = <35>; 
            timeout-ms = <2000>;
        };

        ///////////////////////
        //START Dragmod RIGHT//
        ///////////////////////

       c-hr-thumb-arr {
            bindings = <&kp LS(LCTRL)>;
            key-positions = <35 29 28>;
            layers = <BASE>;
            slow-release;
            key-positions-first-exclude = <35>;
