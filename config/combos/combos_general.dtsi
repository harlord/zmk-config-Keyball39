        };

        c-hr-thumb-stl {
            bindings = <&kp LA(LCMD)>;
            key-positions = <35 22 23>;
            layers = <BASE MOUSE SNIPE WARP SCROLL>;
            slow-release;
            key-positions-first-exclude = <35>;
